{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SideDock",
  "version": "0.5.0",
  "identifier": "com.xelaods.sidedock",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SideDock",
        "url": "index.html",
        "width": 1200,
        "height": 520,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "dragDropEnabled": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline' http://addon.localhost addon:; img-src 'self' data: http://addon.localhost addon:; frame-src http://addon.localhost addon:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../addons/": "addons/"
    },
    "shortDescription": "画面上部に常駐するランチャー",
    "windows": {
      "nsis": {
        "languages": [
          "Japanese"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
